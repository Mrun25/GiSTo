# --- Core ---
ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg2://gisto:gisto@db:5432/gisto
SECRET_KEY=dev-secret-change-me

# --- GSP (GST Suvidha Provider) ---
# "mock" runs without any real credentials (see app/gsp/mock_gsp.py).
# Switch to "whitebooks" or "gsthero" once a vendor is selected (PRD §5.3/§7.2)
# and the corresponding adapter is implemented.
GSP_PROVIDER=mock
GSP_API_KEY=
GSP_BASE_URL=

# --- Invoice extraction ---
# "mock" returns canned data, no LLM key needed. Switch to "mistral" once
# app/extraction/mistral_extraction.py is added (see app/extraction/README.md).
EXTRACTION_PROVIDER=mock
MISTRAL_API_KEY=
ANTHROPIC_API_KEY=

# --- Telegram bot ---
TELEGRAM_BOT_TOKEN=
BACKEND_BASE_URL=http://backend:8000

# --- Risk / alerting ---
FILING_GRACE_PERIOD_DAYS=11
