# Get this from @BotFather on Telegram after creating a bot.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Where the GiSTo FastAPI backend is reachable.
BACKEND_BASE_URL=http://backend:8000

# Proactive notification cadence (seconds). Defaults: hourly alert sweep,
# weekly digest.
ALERT_SWEEP_INTERVAL_SECONDS=3600
DIGEST_INTERVAL_SECONDS=604800
